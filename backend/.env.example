APP_ENV=development
APP_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=sqlite+aiosqlite:///./backend/app.db
STORAGE_BUCKET=intelli-credit-docs
DOCUMENT_PROCESSING_BACKEND=docling_remote
DOCUMENT_BATCH_MAX_CONCURRENCY=4

DOCLING_REMOTE_HOST=
DOCLING_REMOTE_PORT=22
DOCLING_REMOTE_USERNAME=
DOCLING_REMOTE_PASSWORD=
DOCLING_REMOTE_CLIENT_KEY_PATH=
DOCLING_REMOTE_KNOWN_HOSTS=
DOCLING_REMOTE_PYTHON_BIN=python3.10
DOCLING_REMOTE_WORKSPACE=~/.intelli_credit_docling
DOCLING_REMOTE_VENV=~/.intelli_credit_docling/.venv
DOCLING_REMOTE_ENABLE_BOOTSTRAP=true
DOCLING_REMOTE_BOOTSTRAP_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
DOCLING_REMOTE_PAGE_BATCH_SIZE=128
DOCLING_REMOTE_LAYOUT_BATCH_SIZE=128
DOCLING_REMOTE_OCR_BATCH_SIZE=96
DOCLING_REMOTE_TABLE_BATCH_SIZE=4
DOCLING_REMOTE_DOCUMENT_TIMEOUT_SECONDS=1800

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
CLASSIFICATION_REQUIRE_LLM=true
LANDING_AI_API_KEY=
TAVILY_API_KEY=

SUPABASE_URL=
SUPABASE_KEY=
